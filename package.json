{
  "name": "telegram-quest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:cli": "tsc -p tsconfig.cli.json",
    "quest:publish": "npm run build:cli && node dist/cmd/publish-quest.js",
    "vercel:build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npm run quest:publish -- --menu ./menu.json; else npm run build:cli; fi"
  },
  "devDependencies": {
    "@libsql/client": "0.18.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@tursodatabase/serverless": "1.4.1",
    "grammy": "1.46.0",
    "inkjs": "2.4.0"
  }
}
